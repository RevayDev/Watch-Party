# URL pública del backend desplegado (en Render, Railway, VPS, etc.)
# Ejemplo en producción: https://watch-party-server.onrender.com
# En desarrollo local puedes dejarlo vacío o comentar la línea para usar el proxy local
VITE_API_URL=http://localhost:4000

# Enlace de donaciones (Ko-fi) que se muestra en el Home y en el footer.
# Déjalo vacío si aún no lo tienes: la tarjeta aparece como "Próximamente".
# VITE_KOFI_URL=https://ko-fi.com/tu_usuario

# Enlace de donaciones (PayPal). Misma lógica que Ko-fi.
# También es la base de cobro de los Planes de apoyo (#planes): si es un
# paypal.me se le anexa el monto del plan (…/3, …/10, …/25); si no, se usa tal cual.
# VITE_PAYPAL_URL=https://www.paypal.com/paypalme/tu_usuario

# Demo gratuita (rama `demo-free`): badge, contador de salas, enlace Drive y
# deshabilitado visual de persistencia/timer configurable/subida de archivo.
# Default `true` en esta rama (ausente o vacío = demo activada).
# Con `false` todo vuelve al comportamiento original.
# VITE_DEMO_MODE=true
