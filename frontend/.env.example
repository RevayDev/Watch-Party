# URL pública del backend desplegado (en Render, Railway, VPS, etc.)
# Ejemplo en producción: https://watch-party-server.onrender.com
# En desarrollo local puedes dejarlo vacío o comentar la línea para usar el proxy local
VITE_API_URL=http://localhost:4000

# Enlace de donaciones (Patreon) que se muestra en el Home y en el footer.
# Déjalo vacío si aún no lo tienes: la tarjeta aparece como "Próximamente".
# VITE_PATREON_URL=https://www.patreon.com/tu_usuario

# Enlace de donaciones (PayPal). Misma lógica que Patreon.
# VITE_PAYPAL_URL=https://www.paypal.com/paypalme/tu_usuario
