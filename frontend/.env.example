# URL pública del backend desplegado (en Render, Railway, VPS, etc.)
# Ejemplo en producción: https://watch-party-server.onrender.com
# En desarrollo local puedes dejarlo vacío o comentar la línea para usar el proxy local
VITE_API_URL=http://localhost:4000

# Solo servidor: configurar en Vercel para frontend/api/youtube (sin prefijo VITE_).
# No se incluye en el JavaScript público. Ver docs/vercel-media-services.md.
# YOUTUBE_API_KEY=

# Enlace de donaciones (Ko-fi) que se muestra en el Home y en el footer.
# Déjalo vacío si aún no lo tienes: la tarjeta aparece como "Próximamente".
# VITE_KOFI_URL=https://ko-fi.com/tu_usuario

# Enlace de donaciones (PayPal). Misma lógica que Ko-fi.
# VITE_PAYPAL_URL=https://www.paypal.com/paypalme/tu_usuario

# Demo gratuita (rama `demo-free`): badge, contador de salas, enlace Drive y
# deshabilitado visual de persistencia/timer configurable/subida de archivo.
# Default `true` en esta rama (ausente o vacío = demo activada).
# Con `false` todo vuelve al comportamiento original.
# VITE_DEMO_MODE=true

# Browser-hosted rooms use PeerJS public signaling by default.
# Override these values to use an independently deployed HTTPS PeerServer.
# VITE_PEER_HOST=signal.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/

# Relay TURN para cámara y micrófono en salas alojadas en navegador.
# Obligatorio si teléfono y PC están en redes/NAT diferentes. Estas variables
# llegan al navegador: usa credenciales temporales del proveedor TURN, nunca
# el secreto maestro de coturn.
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# VITE_TURN_USERNAME=usuario-temporal
# VITE_TURN_CREDENTIAL=credencial-temporal
