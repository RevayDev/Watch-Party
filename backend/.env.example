# Configuración del Backend (Servidor)

# Puerto en el que corre el servidor (en plataformas como Render / Railway / Heroku esto se asigna automáticamente)
PORT=4000

# Cadena de conexión a MongoDB Atlas o local
# Ejemplo de MongoDB Atlas: mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/watchparty?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/watch_party

# URL del Frontend (tu dominio en Vercel o localhost en desarrollo)
# Ejemplo en Vercel: https://mi-watch-party.vercel.app
CLIENT_URL=http://localhost:5173

# Orígenes extra separados por coma (dominios custom www/apex, previews).
# Acepta entradas exactas y comodines controlados `*.dominio` (solo https).
# Ejemplo: ALLOWED_ORIGINS=https://www.mi-dominio.com,https://mi-dominio.com,*.vercel.app
# ALLOWED_ORIGINS=

# Red local en desarrollo (probar desde el móvil con `vite host:true`).
# 'false' la desactiva; en producción la LAN nunca se permite.
# ALLOW_LAN_DEV=true

# Demo gratuita (cupos fijos: 5 salas, 5 usuarios por sala).
# DEMO_MODE=true

# ORM (hexagonal: el store se elige sin tocar la lógica).
# - ROOM_STORE=auto (default): Mongoose si hay Mongo, si no memoria.
# - ROOM_STORE=prisma: Prisma (misma Mongo; cae a memoria si no conecta).
# ROOM_STORE=auto
# Prisma usa la misma Mongo que Mongoose salvo que pongas otra aquí.
# DATABASE_URL=mongodb://127.0.0.1:27017/watch_party

# Panel admin (fase 1+2 del plan docs/admin-panel-spotify.md).
# Secreto largo y aleatorio; el frontend lo pide por input (nunca va en código).
# Sin esta variable, /api/admin responde 503.
# ADMIN_TOKEN=cambia-este-secreto-largo-y-aleatorio

# Spotify ("Potify" fase 1): OAuth con token en el servidor.
# Crea la app en https://developer.spotify.com/dashboard y pon aquí sus datos.
# REDIRECT_URI debe coincidir con la configurada en el dashboard.
# Sin estas variables, la pestaña Spotify muestra "no configurado".
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:4000/api/spotify/callback

# Spotify fase B (conexión persistente + búsqueda):
# Clave de cifrado AES-256-GCM para los tokens en reposo (hex de 32 bytes).
# Genera UNA por entorno con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# (no compartas la clave entre dev y prod; sin ella la conexión es efímera).
# SPOTIFY_TOKEN_KEY=
# Mercado por defecto de la búsqueda (client-credentials, sin usuario).
# SPOTIFY_MARKET=ES
# Nota dev-vs-prod: SPOTIFY_REDIRECT_URI debe coincidir EXACTA con una de las
# Redirect URIs del dashboard de Spotify; usa una URI por entorno
# (p. ej. http://localhost:4000/api/spotify/callback en dev y
# https://tu-backend/api/spotify/callback en prod, cada una en su app/entorno).
