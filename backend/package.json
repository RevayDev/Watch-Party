{
  "name": "watch-party-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend server for Watch Party platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "load": "node tests/load/run-local.mjs",
    "load:ramp": "node tests/load/ramp.mjs",
    "load:rooms": "node tests/load/rooms-scenarios.mjs"
  },
  "keywords": [
    "watchparty",
    "video",
    "sync",
    "socketio",
    "webrtc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
